{
  "name": "shortkeys",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/platforms/bun.ts",
    "build": "bun tsup src/platforms/netlify.ts -d netlify/functions --format esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "ci": "bun run typecheck && bun run build && bun run test"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.2",
    "@types/bun": "latest",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.2",
    "bluelinky": "^8.3.1",
    "effect": "^4.0.2"
  }
}
